# ──────────────────────────────────────────────────────────────
# Pipecat agent — needs ALL service keys, because this is the
# process that calls STT, LLM, TTS and connects to LiveKit.
# ──────────────────────────────────────────────────────────────

# Speech-to-Text
DEEPGRAM_API_KEY=

# LLM
GROQ_API_KEY=

# Text-to-Speech
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=

# WebRTC transport
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Supabase — service-role key bypasses RLS; never expose to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
