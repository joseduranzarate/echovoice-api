# ──────────────────────────────────────────────────────────────
# REST API — mints LiveKit JWTs for authenticated Clerk users.
# ──────────────────────────────────────────────────────────────

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Clerk — used to verify the session JWT on /token requests.
CLERK_SECRET_KEY=
# Comma-separated list of origins allowed to call /token (CSRF defense in depth).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Supabase — service-role key bypasses RLS; never expose to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
